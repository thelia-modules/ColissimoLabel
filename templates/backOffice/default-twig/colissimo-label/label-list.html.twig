{% for label in labels|default([]) %}
    {% set label_url = path('colissimo_label_order_list', {'number': label.tracking_number}) %}
    <tr>
        <td>
            {% set tracking_url = 'https://www.laposte.fr/particulier/outils/suivre-vos-envois?code=%track'|trans({'%track': label.tracking_number}, 'colissimolabel.bo.default') %}
            <a href="{{ tracking_url }}" target="_blank" rel="noopener">{{ label.tracking_number }}</a>
        </td>
        <td>{{ label.weight }} / Kg</td>
        <td>{{ label.created_at ? label.created_at|date('Y-m-d H:i:s') : '' }}</td>
        <td class="text-end text-nowrap">
            <div class="btn-group btn-group-sm" role="group">
                <a class="btn btn-outline-secondary" href="{{ label_url }}?download=1" title="{{ 'Download'|trans({}, 'colissimolabel.bo.default') }}" aria-label="{{ 'Download'|trans({}, 'colissimolabel.bo.default') }}"><i class="bi bi-download" aria-hidden="true"></i></a>
                <a class="btn btn-outline-secondary" target="_blank" href="{{ label_url }}" title="{{ 'View'|trans({}, 'colissimolabel.bo.default') }}" aria-label="{{ 'View'|trans({}, 'colissimolabel.bo.default') }}"><i class="bi bi-eye" aria-hidden="true"></i></a>
                <a class="btn btn-outline-secondary js-action-print" data-number="{{ label.tracking_number }}" href="{{ label_url }}" title="{{ 'Print'|trans({}, 'colissimolabel.bo.default') }}" aria-label="{{ 'Print'|trans({}, 'colissimolabel.bo.default') }}"><i class="bi bi-printer" aria-hidden="true"></i></a>
                {% if label.has_customs_invoice|default(false) %}
                    <a class="btn btn-outline-secondary" href="{{ label.customs_invoice_url }}" target="_blank" title="{{ 'Download customs invoice (PDF)'|trans({}, 'colissimolabel.bo.default') }}" aria-label="{{ 'Download customs invoice (PDF)'|trans({}, 'colissimolabel.bo.default') }}"><i class="bi bi-globe-europe-africa" aria-hidden="true"></i></a>
                {% endif %}
            </div>
            <form method="post" action="{{ path('colissimo_label_order_delete') }}" class="d-inline" onsubmit="return confirm('{{ 'Do you want to clear this label and tracking number ?'|trans({}, 'colissimolabel.bo.default')|e('js') }}')">
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                <input type="hidden" name="number" value="{{ label.tracking_number }}">
                <input type="hidden" name="order_id" value="{{ label.order_id }}">
                <input type="hidden" name="edit-order" value="1">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="{{ 'Delete'|trans({}, 'colissimolabel.bo.default') }}" aria-label="{{ 'Delete'|trans({}, 'colissimolabel.bo.default') }}"><i class="bi bi-trash" aria-hidden="true"></i></button>
            </form>
        </td>
    </tr>
{% else %}
    <tr>
        <td colspan="4">{{ 'No existing label for this order'|trans({}, 'colissimolabel.bo.default') }}</td>
    </tr>
{% endfor %}
