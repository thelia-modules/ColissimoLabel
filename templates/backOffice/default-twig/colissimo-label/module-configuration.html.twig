{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% set tab = app.request.query.get('tab')|default('config') %}

{% block title %}{{ 'Bordereaux Colissimo'|trans({}, 'colissimolabel.bo.default') }}{% endblock %}
{% block body_testid %}colissimo-label-configuration{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <ul id="tabbed-menu" class="nav nav-tabs card-header-tabs">
                    <li class="nav-item"><a class="nav-link {{ tab == 'bordereaux' ? 'active' : '' }}" href="{{ path('colissimo_label_bordereau_list') }}">{{ 'Bordereaux'|trans({}, 'colissimolabel.bo.default') }}</a></li>
                    <li class="nav-item"><a class="nav-link {{ tab == 'labels' ? 'active' : '' }}" href="{{ path('colissimo_label_labels') }}">{{ 'Labels'|trans({}, 'colissimolabel.bo.default') }}</a></li>
                    <li class="nav-item"><a class="nav-link {{ tab == 'config' ? 'active' : '' }}" href="{{ path('colissimo_label_configuration_configuration') }}">{{ 'Configuration'|trans({}, 'colissimolabel.bo.default') }}</a></li>
                </ul>
            </div>

            <div class="card-body">
                <h5 class="card-title">{{ 'Advanced configuration'|trans({}, 'colissimolabel.bo.default') }}</h5>

                {% if form_error_message is defined and form_error_message %}
                    <div class="alert alert-danger">{{ form_error_message }}</div>
                {% endif %}

                {{ form_start(form, {'action': path('colissimo_label_configuration_save'), 'attr': {'method': 'post'}}) }}

                    <div class="card mb-3">
                        <div class="card-header">{{ 'General informations'|trans({}, 'colissimolabel.bo.default') }}</div>
                        <div class="card-body">
                            <div class="mb-3">
                                {{ form_label(form['colissimolabel-endpoint']) }}
                                {{ form_widget(form['colissimolabel-endpoint'], {attr: {class: 'form-control'}}) }}
                                {{ form_errors(form['colissimolabel-endpoint']) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form['contract-number']) }}
                                {{ form_widget(form['contract-number'], {attr: {class: 'form-control'}}) }}
                                {{ form_errors(form['contract-number']) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form['password']) }}
                                {{ form_widget(form['password'], {attr: {class: 'form-control'}}) }}
                                {{ form_errors(form['password']) }}
                            </div>
                            <div class="form-check mb-3">
                                {{ form_widget(form['default-signed'], {attr: {class: 'form-check-input'}}) }}
                                {{ form_label(form['default-signed'], null, {label_attr: {class: 'form-check-label'}}) }}
                                {{ form_errors(form['default-signed']) }}
                            </div>
                            <div class="form-check mb-3">
                                {{ form_widget(form['generate-bordereau'], {attr: {class: 'form-check-input'}}) }}
                                {{ form_label(form['generate-bordereau'], null, {label_attr: {class: 'form-check-label'}}) }}
                                {{ form_errors(form['generate-bordereau']) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form['default-label-format']) }}
                                {{ form_widget(form['default-label-format'], {attr: {class: 'form-select'}}) }}
                                {{ form_errors(form['default-label-format']) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form['last-bordereau-date']) }}
                                {{ form_widget(form['last-bordereau-date'], {attr: {class: 'form-control'}}) }}
                                {{ form_errors(form['last-bordereau-date']) }}
                            </div>
                            <div class="form-check mb-3">
                                {{ form_widget(form['get-invoices'], {attr: {class: 'form-check-input'}}) }}
                                {{ form_label(form['get-invoices'], null, {label_attr: {class: 'form-check-label'}}) }}
                                {{ form_errors(form['get-invoices']) }}
                            </div>
                            <div class="form-check mb-3">
                                {{ form_widget(form['get-customs-invoices'], {attr: {class: 'form-check-input'}}) }}
                                {{ form_label(form['get-customs-invoices'], null, {label_attr: {class: 'form-check-label'}}) }}
                                {{ form_errors(form['get-customs-invoices']) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form['customs-product-hscode']) }}
                                {{ form_widget(form['customs-product-hscode'], {attr: {class: 'form-control'}}) }}
                                {{ form_errors(form['customs-product-hscode']) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form['postal-network']) }}
                                {{ form_widget(form['postal-network'], {attr: {class: 'form-select'}}) }}
                                {{ form_errors(form['postal-network']) }}
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header">{{ "Sender's address"|trans({}, 'colissimolabel.bo.default') }}</div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        {{ form_label(form['colissimolabel-company-name']) }}
                                        {{ form_widget(form['colissimolabel-company-name'], {attr: {class: 'form-control'}}) }}
                                        {{ form_errors(form['colissimolabel-company-name']) }}
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        {{ form_label(form['colissimolabel-from-contact-email']) }}
                                        {{ form_widget(form['colissimolabel-from-contact-email'], {attr: {class: 'form-control'}}) }}
                                        {{ form_errors(form['colissimolabel-from-contact-email']) }}
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        {{ form_label(form['colissimolabel-from-phone']) }}
                                        {{ form_widget(form['colissimolabel-from-phone'], {attr: {class: 'form-control'}}) }}
                                        {{ form_errors(form['colissimolabel-from-phone']) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form['colissimolabel-from-address-1']) }}
                                        {{ form_widget(form['colissimolabel-from-address-1'], {attr: {class: 'form-control'}}) }}
                                        {{ form_errors(form['colissimolabel-from-address-1']) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form['colissimolabel-from-address-2']) }}
                                        {{ form_widget(form['colissimolabel-from-address-2'], {attr: {class: 'form-control'}}) }}
                                        {{ form_errors(form['colissimolabel-from-address-2']) }}
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="mb-3">
                                        {{ form_label(form['colissimolabel-from-zipcode']) }}
                                        {{ form_widget(form['colissimolabel-from-zipcode'], {attr: {class: 'form-control'}}) }}
                                        {{ form_errors(form['colissimolabel-from-zipcode']) }}
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <div class="mb-3">
                                        {{ form_label(form['colissimolabel-from-city']) }}
                                        {{ form_widget(form['colissimolabel-from-city'], {attr: {class: 'form-control'}}) }}
                                        {{ form_errors(form['colissimolabel-from-city']) }}
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    {{ form_label(form['colissimolabel-from-country']) }}
                                    <select name="{{ form['colissimolabel-from-country'].vars.full_name }}" class="form-select">
                                        {% for country in countries|default([]) %}
                                            <option value="{{ country.id }}"{{ country.id == form['colissimolabel-from-country'].vars.value ? ' selected' : '' }}>{{ country.title }} ({{ country.isocode }})</option>
                                        {% endfor %}
                                    </select>
                                    {{ form_errors(form['colissimolabel-from-country']) }}
                                    {% do form['colissimolabel-from-country'].setRendered %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" name="save_mode" value="stay" class="btn btn-success" title="{{ 'Save changes'|trans({}, 'colissimolabel.bo.default') }}">
                        {{ 'Save changes'|trans({}, 'colissimolabel.bo.default') }} <i class="bi bi-check-lg"></i>
                    </button>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
