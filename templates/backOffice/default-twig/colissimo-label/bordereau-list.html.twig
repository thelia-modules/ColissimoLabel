{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% set tab = app.request.query.get('tab')|default('bordereaux') %}

{% block title %}{{ 'Bordereaux Colissimo'|trans({}, 'colissimolabel.bo.default') }}{% endblock %}
{% block body_testid %}colissimo-label-bordereau-list{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <ul id="tabbed-menu" class="nav nav-tabs card-header-tabs">
                    <li class="nav-item"><a class="nav-link {{ tab == 'bordereaux' ? 'active' : '' }}" href="{{ path('colissimo_label_bordereau_list') }}">{{ 'Bordereaux'|trans({}, 'colissimolabel.bo.default') }}</a></li>
                    <li class="nav-item"><a class="nav-link {{ tab == 'labels' ? 'active' : '' }}" href="{{ path('colissimo_label_labels') }}">{{ 'Labels'|trans({}, 'colissimolabel.bo.default') }}</a></li>
                    <li class="nav-item"><a class="nav-link {{ tab == 'config' ? 'active' : '' }}" href="{{ path('colissimo_label_configuration_configuration') }}">{{ 'Configuration'|trans({}, 'colissimolabel.bo.default') }}</a></li>
                </ul>
            </div>

            <div class="card-body">
                {% if error %}
                    <div class="alert alert-danger" id="error-bordereau">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span id="error-bordereau-message">{{ error }}</span>
                    </div>
                {% endif %}

                <form method="post" action="{{ path('colissimo_label_bordereau_generate') }}" class="mb-3">
                    <input type="hidden" name="_token" value="{{ assignToken() }}">
                    <button type="submit" class="btn btn-info">
                        {{ 'Generate bordereau for label since : %date'|trans({'%date': lastBordereauDate}, 'colissimolabel.bo.default') }}
                    </button>
                </form>

                {% set domain = 'colissimolabel.bo.default' %}
                {% set rows = bordereaux|map(bordereau => {
                    id: bordereau.name,
                    name_html: '<a href="' ~ (path('colissimo_label_bordereau_download') ~ '?fileName=' ~ bordereau.name|url_encode)|e('html_attr') ~ '" target="_blank">' ~ bordereau.name|e ~ '</a>',
                    _actions: [
                        row_action('download', 'Download bordereau'|trans({}, domain), href: path('colissimo_label_bordereau_download') ~ '?stay=1&fileName=' ~ bordereau.name|url_encode),
                        row_action('delete', 'Delete bordereau'|trans({}, domain), modalTarget: '#colissimo-bordereau-delete', dataAttributes: { 'file-name': bordereau.name }),
                    ],
                }) %}

                {{ component('BoDataTable', {
                    id: 'colissimo-bordereaux',
                    columns: [
                        column_html('name_html', 'Bordereau'|trans({}, domain)),
                        column_actions('_actions', 'Actions'|trans({}, domain)),
                    ],
                    rows: rows,
                    emptyMessage: 'No bordereau has been generated yet'|trans({}, domain),
                }) }}

                {{ component('BoConfirmDialog', {
                    id: 'colissimo-bordereau-delete',
                    title: 'Delete bordereau'|trans({}, domain),
                    message: 'Do you want to delete this bordereau ?'|trans({}, domain),
                    formAction: path('colissimo_label_delete'),
                    testid: 'colissimo-bordereau-delete',
                    prefillTrigger: 'data-file-name',
                    prefillInput: 'fileName',
                }) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
